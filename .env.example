# Copy this file to a new file named .env and fill in your values.
# .env is ignored by git, so your keys never get uploaded.
# Find these at app.dataforseo.com → API Access.

DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Optional, from Session 4: makes /check-post much faster at finding sources.
# Find it at console.perplexity.ai → API Keys.
PERPLEXITY_API_KEY=
